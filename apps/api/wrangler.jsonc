{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds checks it).
  "name": "aobtd-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // pg opens TCP/TLS sockets through the Node compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  // Bundle the shared package from source, so no separate build step is needed.
  "alias": { "@aobtd/core": "../../packages/core/src/index.ts" },
  // Run next to the database rather than next to the visitor: one query round trip per request.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Public, so the site can call it from another origin (VITE_API_URL in the web build).
  // A custom domain (Settings -> Domains & Routes) works too; then this can go back to false.
  "workers_dev": true,
  // Keep ALLOWED_ORIGINS set in the dashboard: without this, each deploy would erase it.
  "keep_vars": true
  // Secret (dashboard or `wrangler secret put DATABASE_URL`): DATABASE_URL
  // Variable (dashboard): ALLOWED_ORIGINS, comma-separated site origins allowed by CORS
}
