# PostgreSQL
DATABASE_URL=postgres://aobtd:aobtd@localhost:5432/aobtd

# API
API_PORT=3000
# Pasta com o build do frontend (opcional; em produção a API serve o site)
WEB_DIST=apps/web/dist

# Coletor (servidor MCP)
# Liga o agendador interno (varredura diária escalonada em 4 janelas de 6h)
COLLECTOR_SCHEDULER=on
# Porta do transporte HTTP do MCP (modo --http)
MCP_HTTP_PORT=3333
# Identificação exigida pela política de uso do Nominatim (OpenStreetMap)
GEOCODER_USER_AGENT=aobtd-crash-monitor/1.0 (contato: defina-um-email)
