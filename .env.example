# PostgreSQL
DATABASE_URL=postgres://aobtd:aobtd@localhost:5432/aobtd

# API
API_PORT=3000
# Sites on another origin allowed to call the API from the browser (CORS), comma-separated
ALLOWED_ORIGINS=
# Folder with the frontend build (optional; in production the API serves the site)
WEB_DIST=apps/web/dist

# Collector (MCP server)
# Turns on the internal scheduler (daily scan staggered over 4 windows of 6h)
COLLECTOR_SCHEDULER=on
# Port of the MCP HTTP transport (--http mode)
MCP_HTTP_PORT=3333
# Identification required by the Nominatim (OpenStreetMap) usage policy
GEOCODER_USER_AGENT=aobtd-crash-monitor/1.0 (contact: set-an-email)

# API origin used by the site (read by the frontend build; https only).
# Empty: same origin (dev proxy, Docker, or the web Worker's service binding)
VITE_API_URL=

# Site links (read by the frontend build; https only)
# Repository used for the "Open source" badge and the "report an error" issue link
VITE_REPO_URL=https://github.com/evandroabukamel/aobtd
# Donation pages: each button only shows up when its URL is set
VITE_GITHUB_SPONSORS_URL=
VITE_KOFI_URL=
VITE_BUYMEACOFFEE_URL=
# Pix (Brazil): the button only shows up when VITE_PIX_CODE is a valid "copia e cola" code.
# The QR code in the dialog is generated from it; key, name and transfer code are shown as text.
VITE_PIX_CODE="00020126580014BR.GOV.BCB.PIX013612fb01a1-d76d-47f9-bd01-863088a736c45204000053039865802BR5917Evandro Abu Kamel6007Maringa62240520AircraftCrashMonitor6304D54E"
VITE_PIX_KEY=12fb01a1-d76d-47f9-bd01-863088a736c4
VITE_PIX_NAME="Evandro Abu Kamel"
VITE_PIX_REFERENCE=AircraftCrashMonitor
