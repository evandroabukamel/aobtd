# PostgreSQL
DATABASE_URL=postgres://aobtd:aobtd@localhost:5432/aobtd

# API
API_PORT=3000
# Folder with the frontend build (optional; in production the API serves the site)
WEB_DIST=apps/web/dist

# Collector (MCP server)
# Turns on the internal scheduler (daily scan staggered over 4 windows of 6h)
COLLECTOR_SCHEDULER=on
# Port of the MCP HTTP transport (--http mode)
MCP_HTTP_PORT=3333
# Identification required by the Nominatim (OpenStreetMap) usage policy
GEOCODER_USER_AGENT=aobtd-crash-monitor/1.0 (contact: set-an-email)
